# Environment variables accepted by the services.
#
# Every variable is optional: the values below are the defaults already set in each
# service's application.yaml, pointing to the local docker-compose infrastructure.
#
# To override something locally:
#   1. cp .env.example .env      (.env is gitignored: never commit it)
#   2. edit the values you need
#   3. load it before running a service. Spring Boot does NOT read .env files by itself:
#        terminal:  set -a; source .env; set +a; ./gradlew :services:catalog:bootRun
#        IntelliJ:  EnvFile plugin, add .env to the run configuration

# --- Shared ---------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- catalog --------------------------------------------------------------------
CATALOG_DB_URL=jdbc:postgresql://localhost:5432/catalog
CATALOG_DB_USERNAME=ticketing
CATALOG_DB_PASSWORD=ticketing
